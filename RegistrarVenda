{
    class Program
    {
        
        static void Main(string[] args)
        {

            static bool registrarVenda()
            {
                string dia, nomeProduto;
                int preco;

                string[] produtos = { "Pao", "Cafe", "Fatia de Bolo", "Suco", "Vitamina" };

                string[] semana = { "Segunda", "Terca", "Quarta", "Quinta", "Sexta" };

                int[,] matrizVendas =
                {
                    {250,230,240,260,300},
                    {65,60,70,28,32},
                    {25,22,28,30,40},
                    {30,28,32,35,45},
