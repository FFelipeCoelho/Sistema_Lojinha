using System;
using System.Security.AccessControl;
using System.Security.Principal;

namespace Lanchonete
{
    class Program
    {
        static void Main(string[] args)
        {

            string[] nomes = { "Pão", "Café", "Fatia de bolo", "Suco", "Vitamina" };
            double[] precos = { 0.50, 7.00, 6.50, 12.00, 15.00 };
            string[] dias = { "Segunda", "Terça", "Quarta", "Quinta", "Sexta" };
            int[] vendidos = new int[nomes.Length];
            int quantidade = 0;

            static double FaturamentoSemana(double n, double p)
            {
                double soma = n * p;
                return soma;
            }


         
       



            Console.WriteLine("===== LANCHONETE SENAC =====");

            Console.WriteLine("1 - Ver cardápio");
            Console.WriteLine("2 - Registrar venda");
            Console.WriteLine("3 - Relatorio por produto");
            Console.WriteLine("4 - Relatorio por dia");
            Console.WriteLine("5 - Resumo da semana");
            Console.WriteLine("0 - sair");


            Console.Write("Escolha sua opção: ");
            int opcao = int.Parse(Console.ReadLine());


            switch (opcao)
            {

                case 1:// Feito por Tomás (Serve para mostrar os produtos e preços de um array em formato de lista atraves de um for)
                    for (int i = 0; i < nomes.Length; i++)
                    {
                        Console.WriteLine($" {i + 1} - {nomes[i]} R${precos[i]}");

                    }
                    Console.Write("Escolha seu produto: ");
                    int produto = int.Parse(Console.ReadLine());

                    Console.Write("Digite a quantidade: ");
                    quantidade = int.Parse(Console.ReadLine());

                    Console.WriteLine($"Voce selecionou {nomes[produto - 1]} e {quantidade} unidades!"); // Aqui ele puxa o nome do array de acordo com produto atraves da opção que voce escolheu acima 
                    break;




                case 4: 

                    for (int i = 0; i < dias.Length; i++)
                    {
                        Console.WriteLine($"{i + 1} - {nomes[i]} "); // Feito por Tomás (aqui é a msm parada que la em cima. Mostra os produtos em forma de lista para o usuario poder escolher)
                       

                    }
                    Console.WriteLine("Digite o produto que deseja: ");
                    int produtos2 = int.Parse(Console.ReadLine());

                    for (int i = 0; i < dias.Length; i++) // Aqui percorre pelo o array de dias da mesma forma do nome KKKKKKKKKKK é praticamente tudo o mesmo esquema. 
                    {
                        Console.WriteLine($"{i + 1} - {dias[i]}");
                    }
                    Console.WriteLine("Digite o dia que deseja: ");
                    int dias2 = int.Parse(Console.ReadLine());

                    Console.Write("Digite a quantia do dia: ");
                    int quantiDia = int.Parse(Console.ReadLine());


                    Console.WriteLine($"Venda registrada: {quantiDia} X {nomes[produtos2 - 1]} na {dias[dias2 - 1]}");


                    break;
                    
                  
                case 5:

                    // feito por Tomás (Aqui é so para "Armazenar" um valor numero em uma variavel para poder colocar um valor nela mais para frente)
                    double total = 0;
                    double maior = 0;
                    string ProdutoMais = "";

                    for (int i = 0; i < nomes.Length; i++)
                    {
                        Console.Write($"Digite a quantia do {nomes[i]}: ");
                        int quantia = int.Parse(Console.ReadLine());

                        double faturamento = FaturamentoSemana(quantia, precos[i]);  // aqui é a função la de cima, ela puxa a quantia que o usuario digitou e o for percorre pelo o array de preços la de cima, multiplicando pela quantia.
                        total += faturamento;

                        if (faturamento  > maior) 
                        {
                            maior = faturamento;
                            ProdutoMais = nomes[i];
                        } // esse if serve para falar que se o faturamento for maior que a variavel maior. ela guarda o valor do maior no faturamento e o valor do ProdutoMais em nomes.
                    }
                    Console.WriteLine($"faturamento total da semana: R${total}");
                    Console.WriteLine($"Produto mais vendido: {ProdutoMais} R${maior}");


               
                    break;
                    

         

            

            } while (opcao == 0)
            {
                Console.WriteLine("Saindo.");
                opcao++;
            }
        } 
    }
}
                   
